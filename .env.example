# LLM providers for the Generate step. Add a key here, or connect providers in the
# app under "LLM providers" (keys entered there are stored in the local database).
#
# Free tiers:
# Gemini:  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NVIDIA:  https://build.nvidia.com  (API key from any model page)
NVIDIA_API_KEY=
#
# Any built-in preset is enabled by its <NAME>_API_KEY:
# OPENAI_API_KEY=  ANTHROPIC_API_KEY=  GROQ_API_KEY=  MISTRAL_API_KEY=
# OPENROUTER_API_KEY=  TOGETHER_API_KEY=  DEEPSEEK_API_KEY=
# Local servers need no key, just a base URL:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
#
# Every preset also reads <NAME>_BASE_URL, <NAME>_DEFAULT_MODEL (e.g. to route OpenAI
# through a proxy, or change Gemini's default model).
#
# Custom OpenAI-compatible endpoints (vLLM, LiteLLM, Azure, a company gateway), as JSON:
# LLM_PROVIDERS=[{"name": "my-vllm", "title": "My vLLM", "base_url": "http://gpu-box:8000/v1", "api_key_env": "MY_VLLM_KEY", "default_model": "qwen3-32b"}]
#   optional per entry: "key_required" (default false), "supports_reasoning" (default false), "headers": {...}
#
# Embeddings over an API (Embed → "API model") still use only the Gemini/NVIDIA keys.

# --- Security -----------------------------------------------------------------
# API keys entered in the app are encrypted (AES-256-GCM) with a master key that is
# created on first run in your user config dir (~/.config/raglabs/secret.key,
# %APPDATA%\raglabs\secret.key, ~/Library/Application Support/raglabs/secret.key) —
# not in data/. Back it up: without it, stored keys must be re-entered.
# To manage it yourself (e.g. in a secrets manager), set 32 random bytes, base64:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# RAGLABS_SECRET_KEY=
# RAGLABS_SECRET_KEY_FILE=/path/to/secret.key
#
# Host names the backend answers to (blocks DNS-rebinding attacks from web pages).
# Add your machine's name/IP if you expose the backend on a network; "*" disables.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Requests from this machine need no API key; requests from anywhere else must send
# "Authorization: Bearer rl_…" (create keys on a project's API tab). Behind a reverse proxy every
# request looks local, so set this to false there — then every API call needs a key.
# TRUST_LOOPBACK=true
#
# Code checks (verify.type = execution_check) run model-written Python only inside this Docker
# image, with no network and tight limits. Pick an image that has the libraries your docs cover.
# SANDBOX_IMAGE=python:3.12-slim
